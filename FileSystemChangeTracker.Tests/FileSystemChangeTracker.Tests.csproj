<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Společné vlastnosti (TargetFramework, Nullable, ImplicitUsings) jsou v ../Directory.Build.props.
    Verze balíčků jsou v ../Directory.Packages.props (Central Package Management).
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Podtržítka v názvech testovacích metod jsou běžná konvence (Metoda_Stav_Ocekavani). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- Integrační testy HTTP vrstvy přes WebApplicationFactory (in-memory TestServer). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileSystemChangeTracker.Api\FileSystemChangeTracker.Api.csproj" />
  </ItemGroup>

</Project>
