{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Analysis": {
    // Umístění snapshotů se záměrně NEnastavuje zde: výchozí hodnota je v kódu
    // (AnalysisOptions) a je multiplatformní — Windows %LOCALAPPDATA%, Linux ~/.local/share.
    // Přepsat lze klíčem "SnapshotsDirectory"; proměnné prostředí se expandují, relativní
    // cesta se vztahuje k ContentRoot aplikace. Příklad:
    // "SnapshotsDirectory": "%LOCALAPPDATA%\\FileSystemChangeTracker\\snapshots",

    // Maximální počet souběžně běžících analýz na pozadí (hlavním limitem bývá disk).
    "MaxConcurrentAnalyses": 8,

    // Jak často se během prvního (nedokončeného) běhu ukládá průběžný mezistav — pád procesu
    // ztratí nejvýše takto starou práci. Nad kompletní baseline se mezistav neukládá.
    // "00:00:00" checkpointy vypne.
    "CheckpointInterval": "00:00:30"
  }
}
